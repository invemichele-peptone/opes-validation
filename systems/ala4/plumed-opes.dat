# vim:ft=plumed
# OPES Explore paper (JCTC 2022), alanine tetrapeptide, "bad" CVs with standard parameters (psi-std)
# from invemichele/OPES-explore ala4/opes/plumed.dat
# (NB: in that repository ala4/explore/plumed.dat reads OPES_METAD, here OPES_METAD_EXPLORE is used)
phi1: TORSION ATOMS=5,7,9,15
phi2: TORSION ATOMS=15,17,19,25
phi3: TORSION ATOMS=25,27,29,35
psi1: TORSION ATOMS=7,9,15,17
psi2: TORSION ATOMS=17,19,25,27
psi3: TORSION ATOMS=27,29,35,37
ene: ENERGY

opes: OPES_METAD ...
  ARG=psi1,psi2,psi3
  PACE=500
  BARRIER=50
  NLIST
...

PRINT FMT=%g STRIDE=500 FILE=COLVAR ARG=*

ENDPLUMED

# vim:ft=plumed
# OPES paper (JPCL 2020), alanine tetrapeptide, 6D bias
# from invemichele/opes ala4/plumed-opes.dat, without STATE output
# NB: slow, the number of kernels in 6D keeps growing
phi1: TORSION ATOMS=5,7,9,15
phi2: TORSION ATOMS=15,17,19,25
phi3: TORSION ATOMS=25,27,29,35
psi1: TORSION ATOMS=7,9,15,17
psi2: TORSION ATOMS=17,19,25,27
psi3: TORSION ATOMS=27,29,35,37

opes: OPES_METAD ...
  ARG=phi1,phi2,phi3,psi1,psi2,psi3
  TEMP=300.0
  PACE=500
  SIGMA=0.15,0.15,0.15,0.15,0.15,0.15
  BARRIER=50
  BIASFACTOR=10
...

PRINT FMT=%g STRIDE=500 FILE=COLVAR ARG=*

ENDPLUMED

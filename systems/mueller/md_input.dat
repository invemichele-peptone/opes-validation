nstep             @NSTEP@
tstep             0.005
temperature       1.0
friction          10.0
random_seed       @SEED@
plumed_input      plumed.dat
dimension         2
replicas          1
basis_functions_1 BF_POWERS ORDER=1 MINIMUM=-4.0 MAXIMUM=+3.0
basis_functions_2 BF_POWERS ORDER=1 MINIMUM=-1.0 MAXIMUM=+2.5
input_coeffs       potential.dat
initial_position   @X0@,@Y0@
output_coeffs           /dev/null
output_potential        /dev/null
output_potential_grid   10
output_histogram        /dev/null

# from invemichele/OPES-explore mueller/inputs/input_md.*.dat
# the potential is defined in plumed.dat, potential.dat is a constant
# seed and initial position of each replica are in replicas.dat
